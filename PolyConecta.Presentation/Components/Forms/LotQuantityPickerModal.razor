@*
    Hermano de LotPickerModal para operaciones donde el lote se fracciona: la materia prima
    no sale en unidades completas, sale por kilos. Misma estructura y mismos estados visuales.
*@
@if (Show && Line != null)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.35); z-index: 1050;" @onclick="() => OnClose.InvokeAsync()">
        <div class="bg-white rounded shadow-lg p-4" style="width: 560px;" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Selección de Lotes</h5>
                <button class="btn btn-sm btn-light" @onclick="() => OnClose.InvokeAsync()"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3 small">
                <span class="text-muted">Requerido: <span class="fw-semibold text-dark">@Line.Pendiente.ToString("N1") @Line.Unidad</span></span>
                <span class="text-muted">Declarado: <span class="fw-semibold @(Line.Declarado >= Line.Pendiente ? "text-success" : "text-dark")">@Line.Declarado.ToString("N1") @Line.Unidad</span></span>
                @if (Line.Declarado >= Line.Pendiente && Line.Pendiente > 0)
                {
                    <span class="badge bg-success">Completo</span>
                }
                else if (Line.Asignaciones.Count > 0)
                {
                    <span class="badge bg-warning text-dark">Parcial</span>
                }
            </div>

            <div class="input-group input-group-sm mb-2">
                <span class="input-group-text bg-light"><i class="bi bi-upc-scan"></i></span>
                <input class="form-control" placeholder="Escanear o capturar folio de lote..." @bind="scanValue" @bind:event="oninput" @onkeydown="OnKeyDown" />
                <input type="number" step="0.1" class="form-control" style="max-width:110px;" placeholder="Cantidad" @bind="scanQty" />
                <button class="btn btn-outline-primary" @onclick="Agregar"><i class="bi bi-plus-lg"></i></button>
            </div>
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="text-danger small mb-2"><i class="bi bi-exclamation-circle me-1"></i>@errorMsg</div>
            }

            <div class="border rounded" style="max-height: 260px; overflow-y: auto;">
                @if (Line.Asignaciones.Count == 0)
                {
                    <div class="text-muted small fst-italic p-3 text-center">Sin lotes capturados todavía.</div>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var a in Line.Asignaciones.ToList())
                            {
                                <tr>
                                    <td><code>@a.Lote</code></td>
                                    <td class="text-end small">@a.Cantidad.ToString("N1") @Line.Unidad</td>
                                    <td style="width:30px;"><button class="btn btn-sm btn-link text-danger p-0" @onclick="() => OnRemove.InvokeAsync(a)"><i class="bi bi-x-circle-fill"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (AvailableLots.Count > 0)
            {
                <div class="small text-uppercase fw-semibold text-muted mt-3 mb-1" style="font-size:.7rem;">Disponibles en @Origen</div>
                <div class="border rounded" style="max-height: 150px; overflow-y: auto;">
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var lote in AvailableLots)
                            {
                                <tr>
                                    <td><code>@lote.Lote</code></td>
                                    <td class="text-end small text-muted">@lote.Cantidad.ToString("N1") @Line.Unidad</td>
                                    <td style="width:90px;" class="text-end">
                                        <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => Proponer(lote)">Tomar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-primary btn-sm px-3" @onclick="() => OnClose.InvokeAsync()">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public StockOperationLine? Line { get; set; }
    [Parameter] public List<LotBalance> AvailableLots { get; set; } = new();
    [Parameter] public string Origen { get; set; } = "";
    [Parameter] public EventCallback<(string Lote, decimal Cantidad)> OnAdd { get; set; }
    [Parameter] public EventCallback<LotAllocation> OnRemove { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string scanValue = "";
    private decimal scanQty;
    private string? errorMsg;

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Agregar();
    }

    private void Proponer(LotBalance lote)
    {
        scanValue = lote.Lote;
        // Propuesta: lo que falta o lo que tiene el lote, lo que sea menor. Siempre editable.
        scanQty = Math.Min(Line!.Pendiente - Line.Declarado, lote.Cantidad);
        errorMsg = null;
    }

    private void Agregar()
    {
        errorMsg = null;
        var code = scanValue.Trim();
        if (string.IsNullOrEmpty(code)) return;

        var lote = AvailableLots.FirstOrDefault(l => string.Equals(l.Lote, code, StringComparison.OrdinalIgnoreCase));
        if (lote == null)
        {
            errorMsg = $"Lote {code} no encontrado o no disponible en {Origen}.";
            return;
        }
        if (scanQty <= 0)
        {
            errorMsg = "Capture la cantidad que sale del lote.";
            return;
        }
        if (scanQty > lote.Cantidad)
        {
            errorMsg = $"El lote {code} solo tiene {lote.Cantidad:N1}.";
            return;
        }

        OnAdd.InvokeAsync((lote.Lote, scanQty));
        scanValue = "";
        scanQty = 0;
    }
}
