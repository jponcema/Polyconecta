@inject PolyConecta.Presentation.Services.UiViewState ViewState

<div class="btn-group btn-group-sm o_view_switcher">
    <button class="btn-view @(ViewState.ViewMode == "List" ? "active" : "")" title="Vista de lista" @onclick='() => SetMode("List")'>
        <i class="bi bi-list-ul"></i>
    </button>
    <button class="btn-view @(ViewState.ViewMode == "Kanban" ? "active" : "")" title="Vista kanban" @onclick='() => SetMode("Kanban")'>
        <i class="bi bi-kanban"></i>
    </button>
</div>

@code {
    private void SetMode(string mode) => ViewState.SetViewMode(mode);
}
