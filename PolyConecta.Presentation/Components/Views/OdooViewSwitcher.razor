@inject PolyConecta.Presentation.Services.UiViewState ViewState

<div class="btn-group btn-group-sm">
    <button class="btn @(ViewState.ViewMode == "Kanban" ? "btn-secondary active fw-bold" : "btn-outline-secondary")" @onclick='() => SetMode("Kanban")'>
        <i class="bi bi-kanban me-1"></i> kanban
    </button>
    <button class="btn @(ViewState.ViewMode == "List" ? "btn-secondary active fw-bold" : "btn-outline-secondary")" @onclick='() => SetMode("List")'>
        <i class="bi bi-list-task me-1"></i> list
    </button>
</div>

@code {
    private void SetMode(string mode) => ViewState.SetViewMode(mode);
}
