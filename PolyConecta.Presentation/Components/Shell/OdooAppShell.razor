@using PolyConecta.Presentation.Pages
@inject PolyConecta.Presentation.Services.UiAppShellState ShellState

<div class="d-flex flex-column vh-100 overflow-hidden">
    <OdooTopbar OnNavigate="@NavigateTo" />
    
    <div class="d-flex flex-grow-1 overflow-hidden">
        <OdooSidebar OnNavigate="@NavigateTo" />
        
        <main class="flex-grow-1 overflow-y-auto bg-light">
            @switch (currentScreen)
            {
                case "dashboard":
                    <Dashboard />
                    break;
                case "pedido-form":
                    <PedidoForm OnNavigate="@NavigateTo" />
                    break;
                case "manufactura-form":
                    <ManufacturaForm OnNavigate="@NavigateTo" />
                    break;
                default:
                    <Dashboard />
                    break;
            }
        </main>
    </div>
</div>

@code {
    private string currentScreen = "dashboard";

    protected override void OnInitialized()
    {
        ShellState.OnStateChanged += StateHasChanged;
    }

    private void NavigateTo(string screenId)
    {
        currentScreen = screenId;
        StateHasChanged();
    }
}
