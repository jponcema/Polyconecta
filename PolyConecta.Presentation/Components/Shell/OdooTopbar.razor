@inject PolyConecta.Presentation.Services.UiAppShellState ShellState
@inject NavigationManager Nav

<header class="o_main_navbar">
    <div>
        <button class="app-brand" @onclick="GoHome">
            <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
            <span>PolyConecta</span>
        </button>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="spotlight-search-box position-relative" style="width: 260px;">
            <input type="text" class="form-control form-control-sm rounded-pill border-0 ps-4" style="font-size:0.8rem;" placeholder="spotlight search" value="@ShellState.SpotlightSearchQuery" @oninput="OnSpotlightInput" />
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size:0.8rem;"></i>
        </div>

        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 30px; height: 30px; font-size: 0.85rem; background: rgba(255,255,255,0.2); color: white;">
            A
        </div>
    </div>
</header>

@code {
    private void GoHome() => Nav.NavigateTo("/");

    private void OnSpotlightInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        ShellState.SetSpotlightSearch(val);
    }
}
