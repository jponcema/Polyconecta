@inject PolyConecta.Presentation.Services.UiAppShellState ShellState

<header class="app-topbar d-flex align-items-center justify-content-between px-3" style="background-color: white; border-bottom: 1px solid #E2E8F0; height: 48px;">
    <div>
        <button class="btn btn-outline-secondary border fw-bold d-flex align-items-center gap-2 px-3 py-1" style="font-size:0.9rem;" @onclick="GoHome">
            <i class="bi bi-grid-3x3-gap-fill text-warning"></i>
            <span>PolyConecta</span>
        </button>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="spotlight-search-box position-relative" style="width: 260px;">
            <input type="text" class="form-control form-control-sm rounded-pill bg-light border ps-4" style="font-size:0.8rem;" placeholder="spotlight search" value="@ShellState.SpotlightSearchQuery" @oninput="OnSpotlightInput" />
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-muted" style="font-size:0.8rem;"></i>
        </div>

        <div class="rounded-circle border d-flex align-items-center justify-content-center fw-bold text-secondary" style="width: 30px; height: 30px; font-size: 0.85rem; background:white;">
            A
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private void GoHome() => OnNavigate.InvokeAsync("dashboard");

    private void OnSpotlightInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        ShellState.SetSpotlightSearch(val);
    }
}
