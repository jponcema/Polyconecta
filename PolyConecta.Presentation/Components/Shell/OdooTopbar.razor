@inject NavigationManager Nav
@implements IDisposable

<header class="o_main_navbar">
    <div class="d-flex align-items-center gap-3">
        <button class="app-brand" @onclick="GoHome" title="Inicio">
            <i class="bi bi-grid-3x3-gap-fill fs-5"></i>
        </button>
        @if (!string.IsNullOrEmpty(CurrentModule.Name))
        {
            <span class="o_module_name">@CurrentModule.Name</span>
        }
        @if (CurrentModule.Items.Count > 1)
        {
            <nav class="o_header_menu">
                @foreach (var item in CurrentModule.Items)
                {
                    <a href="@item.Route" class="@(IsActive(item.Route) ? "active" : "")">@item.Label</a>
                }
            </nav>
        }
    </div>

    <div class="d-flex align-items-center gap-3">
        <i class="bi bi-bell fs-5" style="cursor:pointer; opacity:0.9;" title="Notificaciones"></i>
        <div class="d-flex align-items-center gap-2">
            <span class="small">Alejandro Porras</span>
            <i class="bi bi-person-circle fs-4"></i>
        </div>
    </div>
</header>

@code {
    private record ModuleInfo(string Name, List<(string Label, string Route)> Items);

    private static readonly List<(string Prefix, ModuleInfo Info)> ModuleMap = new()
    {
        ("/pedidos", new("Ventas", new() { ("Pedidos", "/pedidos"), ("Disponibilidad", "/disponibilidad"), ("Rutas", "/rutas") })),
        ("/rutas", new("Inventario", new() { ("Disponibilidad", "/disponibilidad"), ("Rutas", "/rutas"), ("Recolecciones", "/recolecciones") })),
        ("/disponibilidad", new("Inventario", new() { ("Disponibilidad", "/disponibilidad"), ("Rutas", "/rutas"), ("Recolecciones", "/recolecciones") })),
        ("/fabricacion", new("Fabricación", new() { ("Fabricación", "/fabricacion"), ("Captura Masiva", "/captura-masiva"), ("Incidencias", "/incidencias") })),
        ("/captura-masiva", new("Fabricación", new() { ("Fabricación", "/fabricacion"), ("Captura Masiva", "/captura-masiva"), ("Incidencias", "/incidencias") })),
        ("/incidencias", new("Fabricación", new() { ("Fabricación", "/fabricacion"), ("Captura Masiva", "/captura-masiva"), ("Incidencias", "/incidencias") })),
        ("/calidad", new("Calidad", new() { ("Calidad", "/calidad") })),
        ("/traslados", new("Logística", new() { ("Traslados", "/traslados"), ("Recepción", "/recepcion"), ("Entregas", "/entregas"), ("Recolecciones", "/recolecciones") })),
        ("/recepcion", new("Logística", new() { ("Traslados", "/traslados"), ("Recepción", "/recepcion"), ("Entregas", "/entregas"), ("Recolecciones", "/recolecciones") })),
        ("/recolecciones", new("Logística", new() { ("Traslados", "/traslados"), ("Recepción", "/recepcion"), ("Entregas", "/entregas"), ("Recolecciones", "/recolecciones") })),
        ("/entregas", new("Logística", new() { ("Traslados", "/traslados"), ("Recepción", "/recepcion"), ("Entregas", "/entregas"), ("Recolecciones", "/recolecciones") })),
        ("/piso", new("Planta", new() { ("Báscula", "/piso/bascula") })),
    };

    private static readonly ModuleInfo Empty = new("", new());

    private ModuleInfo CurrentModule = Empty;

    protected override void OnInitialized()
    {
        UpdateModule();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateModule();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateModule()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        CurrentModule = ModuleMap.FirstOrDefault(m => path.StartsWith(m.Prefix, StringComparison.OrdinalIgnoreCase)).Info ?? Empty;
    }

    private bool IsActive(string route) => new Uri(Nav.Uri).AbsolutePath.StartsWith(route, StringComparison.OrdinalIgnoreCase);

    private void GoHome() => Nav.NavigateTo("/");

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
