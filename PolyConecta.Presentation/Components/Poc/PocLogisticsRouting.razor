<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-bold text-slate-800">
            <i class="bi bi-truck text-primary me-2"></i> Motor Logístico & Ruteo Interplanta (Odoo Smart Buttons)
        </h5>
        <div class="d-flex gap-2">
            <!-- Smart Buttons Estilo Odoo 19 -->
            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 fw-semibold px-3" @onclick="OnDirectShipment">
                <i class="bi bi-box-seam fs-6"></i>
                <div class="text-start">
                    <small class="d-block text-muted" style="font-size: 0.65rem;">ENTREGAS DIRECTAS</small>
                    <span>Embarque Cliente</span>
                </div>
            </button>
            <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 fw-semibold px-3" @onclick="OnStartTransfer">
                <i class="bi bi-arrow-left-right fs-6"></i>
                <div class="text-start">
                    <small class="d-block text-white-50" style="font-size: 0.65rem;">TRASLADOS INTERPLANTA</small>
                    <span>PIM → Santa Cruz</span>
                </div>
            </button>
        </div>
    </div>
    <div class="card-body p-4">
        <h6 class="fw-bold mb-3 text-slate-800">
            <i class="bi bi-bezier2 me-2 text-indigo"></i> Traspaso de Almacén en 2 Pasos (`PIM-TR-OUT` → `STC-TR-IN`)
        </h6>

        <div class="row g-4 align-items-center">
            <!-- Paso 1: Salida Apodaca PIM -->
            <div class="col-md-5">
                <div class="p-3 border rounded @(TransferStep >= 1 ? "bg-primary-subtle border-primary" : "bg-light")">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary">Paso 1: Salida PIM</span>
                        <small class="text-muted"><code>PIM-TR-OUT</code></small>
                    </div>
                    <p class="mb-2 small">Origen: <strong>PIM/Stock/PT</strong> → Destino Virtual: <strong>TRANSIT/PIM-STC</strong></p>
                    <small class="text-muted d-block mb-2">* Material en tránsito (sin afectar contabilidad en CONTPAQi).</small>
                    <button class="btn btn-sm btn-primary w-100 fw-bold" @onclick="OnExecuteStep1" disabled="@(TransferStep >= 1)">
                        <i class="bi bi-truck me-1"></i> @(TransferStep >= 1 ? "Salida Enviada a Tránsito ✓" : "Validar Salida a Tránsito")
                    </button>
                </div>
            </div>

            <!-- Conector -->
            <div class="col-md-2 text-center">
                <i class="bi bi-arrow-right-circle-fill fs-2 text-muted"></i>
            </div>

            <!-- Paso 2: Recepción Validada Santa Cruz STC -->
            <div class="col-md-5">
                <div class="p-3 border rounded @(TransferStep >= 2 ? "bg-success-subtle border-success" : "bg-light")">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-success">Paso 2: Recepción Santa Cruz</span>
                        <small class="text-muted"><code>STC-TR-IN</code></small>
                    </div>
                    <p class="mb-2 small">Origen: <strong>TRANSIT/PIM-STC</strong> → Destino: <strong>STC/Stock/MP</strong></p>
                    <small class="text-muted d-block mb-2">* Al confirmar recepción, dispara el Traspaso en CONTPAQi ERP.</small>
                    <button class="btn btn-sm btn-success w-100 fw-bold" @onclick="OnExecuteStep2" disabled="@(TransferStep != 1)">
                        <i class="bi bi-check2-circle me-1"></i> @(TransferStep >= 2 ? "Traspaso ERP Disparado ✓" : "Validar Recepción en SC")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int TransferStep { get; set; } = 0;
    [Parameter] public EventCallback<int> TransferStepChanged { get; set; }

    private async Task OnDirectShipment()
    {
        // Direct shipment simulation
    }

    private async Task OnStartTransfer()
    {
        TransferStep = 0;
        await TransferStepChanged.InvokeAsync(TransferStep);
    }

    private async Task OnExecuteStep1()
    {
        TransferStep = 1;
        await TransferStepChanged.InvokeAsync(TransferStep);
    }

    private async Task OnExecuteStep2()
    {
        TransferStep = 2;
        await TransferStepChanged.InvokeAsync(TransferStep);
    }
}
