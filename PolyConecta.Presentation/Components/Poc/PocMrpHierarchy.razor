<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-bold text-slate-800">
            <i class="bi bi-diagram-3 text-indigo me-2"></i> Jerarquía MRP Tripartita (`OM` → `OF` → `WO`)
        </h5>
        <span class="badge bg-primary px-3 py-2">
            Orden Maestra: OM-2026-IV214
        </span>
    </div>
    <div class="card-body p-4">
        <!-- Árbol de Órdenes de Fabricación por Proceso -->
        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-light">
                    <tr>
                        <th>Folio OF</th>
                        <th>Proceso</th>
                        <th>Planta</th>
                        <th>Estado OF</th>
                        <th>WO Asignada</th>
                        <th>Centro Trabajo / Máquina</th>
                        <th>Acción / Estado WO</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- OF-EXT (Extrusión Apodaca PIM) -->
                    <tr class="table-active-row">
                        <td><strong class="text-primary">OF-EXT-2026-IV214-1</strong></td>
                        <td><span class="badge bg-teal text-white">Extrusión</span></td>
                        <td>PIM (Apodaca)</td>
                        <td>
                            <span class="badge @(ExtrusionState == "Borrador" ? "bg-warning text-dark" : "bg-success")">
                                @ExtrusionState
                            </span>
                        </td>
                        <td><code>WO-EXT-01</code></td>
                        <td>
                            <span class="badge @(AssignedMachine == "Por programar" ? "bg-secondary" : "bg-dark")">
                                @AssignedMachine
                            </span>
                        </td>
                        <td>
                            @if (AssignedMachine == "Por programar")
                            {
                                <button class="btn btn-xs btn-outline-primary" @onclick="OnAssignExtruder">
                                    <i class="bi bi-play-fill"></i> Programar Máquina (EXT-01)
                                </button>
                            }
                            else
                            {
                                <span class="text-success small fw-bold">
                                    <i class="bi bi-gear-wide-connected spin me-1"></i> En progreso (2026-09-16)
                                </span>
                            }
                        </td>
                    </tr>

                    <!-- OF-IMP (Impresión Flexográfica PIM) -->
                    <tr>
                        <td><strong>OF-IMP-2026-IV214-2</strong></td>
                        <td><span class="badge bg-info text-dark">Impresión</span></td>
                        <td>PIM (Apodaca)</td>
                        <td><span class="badge bg-secondary">Borrador</span></td>
                        <td><code>WO-IMP-01</code></td>
                        <td><span class="badge bg-secondary">Por programar</span></td>
                        <td><span class="text-muted small">En espera de rollos extruidos</span></td>
                    </tr>

                    <!-- OF-BOL (Bolseo Santa Cruz STC) -->
                    <tr>
                        <td><strong>OF-BOL-2026-IV214-3</strong></td>
                        <td><span class="badge bg-purple text-white" style="background-color: #6B21A8;">Bolseo / Corte</span></td>
                        <td>STC (Santa Cruz)</td>
                        <td><span class="badge bg-secondary">Borrador</span></td>
                        <td><code>WO-BOL-01</code></td>
                        <td><span class="badge bg-secondary">Por programar</span></td>
                        <td><span class="text-muted small">Auto-Confirmar al recibir traspaso</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Ingesta de BoM Excel Dinámico -->
        <div class="mt-4 p-3 border rounded bg-white">
            <h6 class="fw-bold mb-3 text-slate-800">
                <i class="bi bi-file-earmark-spreadsheet text-success me-2"></i> Ingesta de Formulación Co-Extrusión 3 Capas (Planner Extrusión)
            </h6>
            
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small text-muted">Cargar Plantilla Excel de Receta (.xlsx)</label>
                    <div class="input-group">
                        <input type="file" class="form-control form-control-sm" disabled="@BomLoaded" />
                        <button class="btn btn-sm btn-success" @onclick="OnLoadBom" disabled="@BomLoaded">
                            <i class="bi bi-upload me-1"></i> Parsear Receta
                        </button>
                    </div>
                </div>

                <div class="col-md-8">
                    @if (BomLoaded)
                    {
                        <div class="p-2 border rounded bg-slate-50 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div><small class="text-muted">Tolva A (33%):</small> <strong>LDPE Virgen (80%) + Masterbatch (20%)</strong></div>
                                <div><small class="text-muted">Tolva B (34%):</small> <strong>LLDPE Resina (95%) + Aditivo (5%)</strong></div>
                                <div><small class="text-muted">Tolva C (33%):</small> <strong>LDPE Virgen (100%)</strong></div>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Reserva MP en PIM/Stock/MP</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">
                            Adjunta la formulación para calcular insumos por tolva y reservar materias primas en piso.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ExtrusionState { get; set; } = "Borrador";
    [Parameter] public string AssignedMachine { get; set; } = "Por programar";
    [Parameter] public bool BomLoaded { get; set; } = false;

    [Parameter] public EventCallback OnExtruderAssigned { get; set; }
    [Parameter] public EventCallback OnBomParsed { get; set; }

    private async Task OnLoadBom()
    {
        BomLoaded = true;
        ExtrusionState = "Confirmada";
        if (OnBomParsed.HasDelegate)
        {
            await OnBomParsed.InvokeAsync();
        }
    }

    private async Task OnAssignExtruder()
    {
        AssignedMachine = "EXT-01 (Extrusora Línea 1)";
        ExtrusionState = "En progreso";
        if (OnExtruderAssigned.HasDelegate)
        {
            await OnExtruderAssigned.InvokeAsync();
        }
    }
}
