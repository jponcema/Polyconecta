<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-purple text-white py-3 d-flex align-items-center justify-content-between" style="background-color: #6B21A8;">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-scissors me-2"></i> Módulo Conversión / Bolseo en Planta Santa Cruz (`OF-BOL`)
        </h5>
        <span class="badge bg-white text-dark px-3 py-2 fw-bold">
            OF-BOL-2026-IV214-3
        </span>
    </div>
    <div class="card-body p-4 bg-light">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border p-4 bg-white shadow-xs">
                    <h6 class="fw-bold mb-3 text-slate-800 border-bottom pb-2">
                        Captura Dual — Bolseo & Pesaje Físico Bultos
                    </h6>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Millares Producidos (Comercial)</label>
                            <div class="input-group">
                                <input type="number" class="form-control form-control-lg fw-bold text-primary" @bind="ProducedThousands" step="1" />
                                <span class="input-group-text">MIL</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Peso Neto Total Bultos (Báscula)</label>
                            <div class="input-group">
                                <input type="number" class="form-control form-control-lg fw-bold text-dark" @bind="ProducedWeightKg" step="1" />
                                <span class="input-group-text">KG</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-purple-subtle border border-purple rounded mb-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted d-block fw-semibold">FACTOR DE CONVERSIÓN REAL CALCULADO</small>
                                <strong class="fs-3 fw-black text-purple" style="color: #6B21A8;">@RealFactorKgPerThousand.ToString("F2") KG / MILLAR</strong>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Factor Ficha Técnica:</small>
                                <span class="badge bg-secondary">8.50 Kg/Millar</span>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-purple text-white btn-lg w-100 fw-bold py-2" style="background-color: #6B21A8;" @onclick="OnCompleteBagging" disabled="@BaggingDone">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @(BaggingDone ? "OF-BOL Finalizada & Pedido Hecho ✓" : "Finalizar OF-BOL & Marcar Pedido Hecho")
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border p-4 bg-white shadow-xs">
                    <h6 class="fw-bold mb-3 text-slate-800 border-bottom pb-2">
                        <i class="bi bi-shield-check me-2 text-success"></i> Cumplimiento de las 4 Reglas Universales de Manufactura
                    </h6>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex align-items-center justify-content-between py-2">
                            <span><strong>Regla 1:</strong> Confirmar OF exige especificar insumos</span>
                            <span class="badge bg-success">Cumplido ✓</span>
                        </li>
                        <li class="list-group-item d-flex align-items-center justify-content-between py-2">
                            <span><strong>Regla 2:</strong> WO nace en 'Por programar' y pasa a 'En progreso' al asignar máquina/fecha</span>
                            <span class="badge bg-success">Cumplido ✓</span>
                        </li>
                        <li class="list-group-item d-flex align-items-center justify-content-between py-2">
                            <span><strong>Regla 3:</strong> Vaciado desde diarios + Coexistencia de Órdenes de Calidad por ítem</span>
                            <span class="badge bg-success">Cumplido ✓</span>
                        </li>
                        <li class="list-group-item d-flex align-items-center justify-content-between py-2">
                            <span><strong>Regla 4:</strong> Cierre técnico calcula balance de masa y descuenta insumos en bloque en ERP</span>
                            <span class="badge bg-success">Cumplido ✓</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public decimal ProducedThousands { get; set; } = 50.0m;
    [Parameter] public decimal ProducedWeightKg { get; set; } = 425.0m;
    [Parameter] public bool BaggingDone { get; set; } = false;

    private decimal RealFactorKgPerThousand => ProducedThousands > 0 ? ProducedWeightKg / ProducedThousands : 0.0m;

    [Parameter] public EventCallback OnBaggingCompleted { get; set; }

    private async Task OnCompleteBagging()
    {
        BaggingDone = true;
        if (OnBaggingCompleted.HasDelegate) await OnBaggingCompleted.InvokeAsync();
    }
}
