<div class="row g-4">
    <div class="col-md-5">
        <h6 class="fw-bold mb-3 text-slate-800"><i class="bi bi-list-check me-2 text-primary"></i>Rollos Registrados</h6>
        <div class="list-group shadow-xs">
            @if (Lotes.Count == 0)
            {
                <div class="list-group-item text-muted small fst-italic">Sin rollos capturados todavía.</div>
            }
            @foreach (var lote in Lotes)
            {
                <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="fw-bold fs-6"><code>@lote.Lote</code></div>
                        <small class="opacity-75">@lote.Real.ToString("N2") @lote.Unidad</small>
                    </div>
                    <span class="badge @BadgeClass(lote)">@lote.Estado</span>
                </div>
            }
        </div>
    </div>

    <div class="col-md-7">
        <div class="card border p-4 bg-white shadow-xs">
            <h6 class="fw-bold mb-3 text-slate-800 border-bottom pb-2">Captura Báscula — Nuevo Rollo</h6>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label small text-muted">Peso Bruto (kg)</label>
                    <div class="input-group">
                        <input type="number" class="form-control form-control-lg fw-bold text-dark" @bind="GrossWeightKg" step="0.5" />
                        <span class="input-group-text bg-light">KG</span>
                    </div>
                </div>
                <div class="col-6">
                    <label class="form-label small text-muted">Tara Cono (kg)</label>
                    <div class="input-group">
                        <input type="number" class="form-control form-control-lg fw-bold text-muted" @bind="TareWeightKg" step="0.1" />
                        <span class="input-group-text bg-light">KG</span>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-slate-100 rounded mb-4">
                <span class="text-muted small d-block fw-semibold">PESO NETO CALCULADO</span>
                <span class="fs-2 fw-black text-primary">@NetWeightKg.ToString("F2") KG</span>
            </div>

            <button class="btn btn-primary btn-lg w-100 fw-bold py-2" @onclick="Registrar">
                <i class="bi bi-plus-circle-fill me-2"></i> Registrar Rollo
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<ProductionLot> Lotes { get; set; } = new();
    [Parameter] public EventCallback<(decimal Gross, decimal Tare)> OnRegistered { get; set; }

    private decimal GrossWeightKg;
    private decimal TareWeightKg = 5.0m;
    private decimal NetWeightKg => GrossWeightKg - TareWeightKg;

    private static string BadgeClass(ProductionLot lote) => lote.Estado switch
    {
        "Aprobado" => "bg-success",
        "Rechazado" => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task Registrar()
    {
        if (GrossWeightKg <= 0) return;
        if (OnRegistered.HasDelegate) await OnRegistered.InvokeAsync((GrossWeightKg, TareWeightKg));
        GrossWeightKg = 0;
        TareWeightKg = 5.0m;
    }
}
