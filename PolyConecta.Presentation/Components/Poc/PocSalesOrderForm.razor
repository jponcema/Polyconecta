@inject OperationalFlowState Flow
<div>
    <h3 class="fw-bold mb-1">Pedido</h3>
    <h4 class="fw-bold text-primary mb-3">@OperationalFlowState.PedidoFolio</h4>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="o_form_label_row">
                <span class="o_form_label">Cliente</span>
                <span class="o_form_value fw-semibold">
                    EMPRESA MEXICANA DE MANUFACTURA
                    <span class="d-block small text-muted fw-normal">Av. Pedro Ramirez Vazquez # 200-13 Piso 5</span>
                    <span class="d-block small text-muted fw-normal">Col. Valle Oriente, San Pedro Garza Garcia, N.L. C.P. 66269</span>
                    <span class="d-block small text-muted fw-normal">RFC: EMM 750712 7Z2</span>
                </span>
            </div>
            <div class="o_form_label_row">
                <span class="o_form_label">Agente</span>
                <span class="o_form_value">@Flow.Agente</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="o_form_label_row">
                <span class="o_form_label">Fecha</span>
                <span class="o_form_value">27/04/2026</span>
            </div>
            <div class="o_form_label_row">
                <span class="o_form_label">Fecha Est. Entrega</span>
                <span class="o_form_value">05/05/2026</span>
            </div>
            <div class="o_form_label_row">
                <span class="o_form_label">Orden de Compra</span>
                <span class="o_form_value">@Flow.OrdenCompraCliente</span>
            </div>
            <div class="o_form_label_row">
                <span class="o_form_label">Contpaq ID</span>
                <span class="o_form_value">@Flow.ContpaqId</span>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active">Detalle</button></li>
    </ul>
    <div class="mb-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>Clave</th>
                    <th>Producto</th>
                    <th class="text-end" style="width: 100px;">Cantidad</th>
                    <th style="width: 90px;">Unidad</th>
                    <th class="text-end" style="width: 140px;">Precio Unitario</th>
                    <th class="text-end" style="width: 110px;">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold text-primary">PT1113 C567</td>
                    <td class="small">
                        BOLSA MEDIANA 44X84 C.430 BOL-004 [77]
                        <button class="btn btn-sm btn-link p-0 ms-1" title="Ficha técnica" @onclick="() => ShowFichaTecnica = true">
                            <i class="bi bi-file-text"></i>
                        </button>
                    </td>
                    <td class="text-end">
                        <input type="number" class="form-control form-control-sm text-end d-inline-block o_inline_input" style="width: 90px;" @bind="RequestedQty" />
                    </td>
                    <td>
                        <select class="form-select form-select-sm o_inline_input" @bind="RequestedUom">
                            <option value="PZA">PZA</option>
                            <option value="KG">KG</option>
                            <option value="MIL">MIL</option>
                        </select>
                    </td>
                    <td class="text-end text-muted">$@UnitPrice.ToString("N2")</td>
                    <td class="text-end fw-semibold">$@((RequestedQty * UnitPrice).ToString("N2"))</td>
                </tr>
            </tbody>
        </table>
        <div class="row">
            <div class="col-md-8"></div>
            <div class="col-md-4">
                <div class="o_form_label_row"><span class="o_form_label">Subtotal</span><span class="o_form_value">$@Subtotal.ToString("N2")</span></div>
                <div class="o_form_label_row"><span class="o_form_label">IVA</span><span class="o_form_value">$@Iva.ToString("N2")</span></div>
                <div class="o_form_label_row"><span class="o_form_label fw-bold">Total</span><span class="o_form_value fw-bold">$@Total.ToString("N2")</span></div>
            </div>
        </div>
    </div>

    <h6 class="text-uppercase text-muted small fw-bold mb-2">Procesos Requeridos</h6>
    <div class="o_section_card">
        <table class="table table-sm align-middle mb-0">
            <thead class="text-muted small"><tr><th style="width:40px;"></th><th>Proceso</th><th>Origen</th><th>Producto</th></tr></thead>
            <tbody>
                @foreach (var proc in Flow.Procesos)
                {
                    <tr>
                        <td><input type="checkbox" class="form-check-input" checked="@proc.Activo" disabled /></td>
                        <td class="fw-semibold">@ProcesoLabel(proc.Proceso)</td>
                        <td class="small">@proc.Origen</td>
                        <td class="small">@proc.Producto</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (ShowFichaTecnica)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.35); z-index: 1050;" @onclick="() => ShowFichaTecnica = false">
        <div class="bg-white rounded shadow-lg p-4" style="width: 820px;" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Especificaciones de producción</h5>
                <button class="btn btn-sm btn-light" @onclick="() => ShowFichaTecnica = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="o_form_label_row"><span class="o_form_label">Tipo Material</span><input class="form-control form-control-sm o_inline_input" @bind="MaterialType" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">Media de Rollo</span><input class="form-control form-control-sm o_inline_input" @bind="RollTypeDescriptor" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">Calibre</span><input class="form-control form-control-sm o_inline_input" @bind="GaugeMicron" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">KG/Rollo</span><input class="form-control form-control-sm o_inline_input" @bind="KgPerRoll" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">Tratado</span><input class="form-control form-control-sm o_inline_input" @bind="Treatment" /></div>
                </div>
                <div class="col-md-6">
                    <div class="o_form_label_row"><span class="o_form_label">Pigmento</span><input class="form-control form-control-sm o_inline_input" @bind="Pigment" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">Aditivo</span><input class="form-control form-control-sm o_inline_input" @bind="Additive" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">Perforación</span><input class="form-control form-control-sm o_inline_input" @bind="Perforacion" /></div>
                    <div class="o_form_label_row"><span class="o_form_label">Impresión</span><input class="form-control form-control-sm o_inline_input" @bind="Impresion" /></div>
                    <div class="o_form_label_row">
                        <span class="o_form_label">Kg Por fabricar</span>
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <input class="form-control form-control-sm o_inline_input" @bind="TargetProductionKgDesde" />
                            <span class="text-muted small">a</span>
                            <input class="form-control form-control-sm o_inline_input" @bind="TargetProductionKg" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-outline-secondary btn-sm px-3" @onclick="() => ShowFichaTecnica = false">Cancelar</button>
                <button class="btn btn-primary btn-sm px-3" @onclick="() => ShowFichaTecnica = false">Aceptar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public decimal RequestedQty { get; set; } = 5500.0m;
    [Parameter] public string RequestedUom { get; set; } = "PZA";
    [Parameter] public decimal UnitPrice { get; set; } = 5.70m;

    [Parameter] public string MaterialType { get; set; } = "Polietileno Baja Densidad (LDPE Termoencogible)";
    [Parameter] public string RollTypeDescriptor { get; set; } = "Tubular 20.5 x 370";
    [Parameter] public decimal GaugeMicron { get; set; } = 60.0m;
    [Parameter] public decimal KgPerRoll { get; set; } = 100.0m;
    [Parameter] public string Treatment { get; set; } = "Sin tratamiento corona";
    [Parameter] public string Pigment { get; set; } = "Natural (sin pigmentar)";
    [Parameter] public string Additive { get; set; } = "Antibloqueo";
    [Parameter] public string Perforacion { get; set; } = "No";
    [Parameter] public string Impresion { get; set; } = "Sí";
    [Parameter] public decimal TargetProductionKg { get; set; } = 500.0m;
    [Parameter] public decimal TargetProductionKgDesde { get; set; } = 490.0m;

    private bool ShowFichaTecnica = false;
    private string Tab = "detalle";

    private decimal Subtotal => RequestedQty * UnitPrice;
    private decimal Iva => Subtotal * 0.16m;
    private decimal Total => Subtotal + Iva;

    private static string ProcesoLabel(string proceso) => proceso switch
    {
        "Extrusion" => "Extrusión",
        "Impresion" => "Impresión",
        "Bolseo" => "Bolseo",
        _ => proceso
    };
}
