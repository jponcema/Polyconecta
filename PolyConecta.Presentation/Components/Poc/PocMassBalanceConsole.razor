<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-bold text-slate-800">
            <i class="bi bi-calculator text-teal me-2"></i> Balance de Masa & Cierre Técnico Consolidado ERP
        </h5>
        <span class="badge bg-teal text-white px-3 py-2">
            Consumo al Cierre OF-EXT
        </span>
    </div>
    <div class="card-body p-4">
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="p-3 border rounded bg-slate-50">
                    <small class="text-muted d-block fw-semibold">MATERIA PRIMA INSUMO</small>
                    <strong class="fs-4 text-dark">500.00 KG</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded bg-slate-50">
                    <small class="text-muted d-block fw-semibold">ROLLOS PRODUCIDOS (BUENOS)</small>
                    <strong class="fs-4 text-success">450.00 KG</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded bg-slate-50">
                    <small class="text-muted d-block fw-semibold">SCRAP / MERMA EXTRUSIÓN</small>
                    <strong class="fs-4 text-warning">48.50 KG</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded bg-success-subtle border-success">
                    <small class="text-success d-block fw-semibold">DIFERENCIA / VARIANZA (%)</small>
                    <strong class="fs-4 text-success">0.30% (&lt;= 2.0% OK)</strong>
                </div>
            </div>
        </div>

        <div class="p-3 border rounded bg-light d-flex align-items-center justify-content-between">
            <div>
                <strong class="d-block text-dark">Regla de Afectación Consolidada CONTPAQi Premium:</strong>
                <small class="text-muted">El ERP ejecutará un único descuento consolidado de 500 kg de MP al presionar Cierre Técnico.</small>
            </div>
            <button class="btn btn-teal text-white fw-bold px-4 py-2" @onclick="OnExecuteClosure" disabled="@Closed">
                <i class="bi bi-box-arrow-in-down me-1"></i>
                @(Closed ? "Cierre Técnico Ejecutado en CONTPAQi ✓" : "Ejecutar Cierre Técnico & Afectar ERP")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Closed { get; set; } = false;
    [Parameter] public EventCallback OnClosureCompleted { get; set; }

    private async Task OnExecuteClosure()
    {
        Closed = true;
        if (OnClosureCompleted.HasDelegate) await OnClosureCompleted.InvokeAsync();
    }
}
