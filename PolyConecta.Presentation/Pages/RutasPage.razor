@page "/rutas"
@inject ProcurementState Procurement
@inject InventoryState Inv
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <OdooBreadcrumb Items="@(new List<OdooBreadcrumb.Crumb> { new("Rutas de abastecimiento", "/rutas") })" />
    </div>
</div>

<div class="p-4">
    <div class="o_form_sheet mb-3">
        <div class="o_sheet_body">
            <h5 class="fw-bold mb-1">Reglas de abastecimiento</h5>
            <p class="text-muted small mb-0" style="max-width:820px;">
                Cada ruta es una secuencia de reglas. Al autorizar un pedido, el motor las aplica en orden:
                lo que una regla no cubre se convierte en la necesidad que resuelve la siguiente, y una regla de
                fabricación vuelve a lanzar necesidades por sus componentes. Así, un producto con existencia
                no dispara ninguna orden de fabricación.
            </p>
        </div>
    </div>

    @foreach (var ruta in Procurement.Rutas)
    {
        <div class="o_section_card mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <div>
                    <span class="fw-bold">@ruta.Nombre</span>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2">@ruta.Codigo</span>
                </div>
                <span class="badge @(ruta.ConsumeStockPrimero ? "bg-primary-subtle text-primary-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                    @(ruta.ConsumeStockPrimero ? "MTSO — consume existencia primero" : "MTO — fabrica siempre")
                </span>
            </div>
            <table class="table table-sm align-middle mb-0">
                <thead class="text-muted" style="font-size:.75rem;">
                    <tr>
                        <th class="text-center" style="width:50px;">#</th>
                        <th style="width:180px;">Acción</th>
                        <th style="width:180px;">Origen</th>
                        <th style="width:180px;">Destino</th>
                        <th>Tipo de operación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var regla in ruta.Reglas.OrderBy(r => r.Secuencia))
                    {
                        <tr>
                            <td class="text-center text-muted small">@regla.Secuencia</td>
                            <td><span class="badge @BadgeAccion(regla.Accion)">@regla.AccionLabel</span></td>
                            <td class="small text-muted">@regla.Origen</td>
                            <td class="small text-muted">@regla.Destino</td>
                            <td class="small font-monospace text-muted">@regla.TipoOperacion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="o_form_sheet">
        <div class="o_sheet_body">
            <h6 class="text-uppercase text-muted small fw-bold mb-2">Asignación de rutas</h6>
            <p class="text-muted small">
                La ruta se resuelve en cascada: <strong>línea del pedido → producto → clasificación → predeterminada</strong>.
                Lo que Atención a Clientes elige en la línea manda sobre todo lo demás.
            </p>

            <table class="table table-sm align-middle mb-0">
                <thead class="text-muted small">
                    <tr>
                        <th style="width:15%;">Clave</th>
                        <th>Producto</th>
                        <th style="width:170px;">Clasificación</th>
                        <th style="width:220px;">Ruta por producto</th>
                        <th style="width:190px;">Ruta efectiva</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Inv.Catalogo.Where(p => p.Clasificacion != ProductClass.Scrap))
                    {
                        var resolucion = Procurement.Resolver(prod.Clave);
                        <tr>
                            <td class="small fw-semibold text-primary">@prod.Clave</td>
                            <td class="small">@prod.Nombre</td>
                            <td class="small text-muted">@InventoryState.ClassLabel(prod.Clasificacion)</td>
                            <td>
                                <select class="form-select form-select-sm" @onchange="(e) => SetRutaProducto(prod.Clave, e.Value?.ToString())">
                                    <option value="">— hereda de la clasificación —</option>
                                    @foreach (var r in Procurement.Rutas)
                                    {
                                        <option value="@r.Codigo" selected="@(RutaProducto(prod.Clave) == r.Codigo)">@r.Codigo</option>
                                    }
                                </select>
                            </td>
                            <td class="small">
                                <span class="fw-semibold">@resolucion.Ruta.Codigo</span>
                                <span class="d-block text-muted" style="font-size:.72rem;">@resolucion.NivelLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <h6 class="text-uppercase text-muted small fw-bold mb-2 mt-4">Ruta por clasificación</h6>
            <table class="table table-sm align-middle mb-0">
                <thead class="text-muted small">
                    <tr><th style="width:220px;">Clasificación</th><th>Ruta</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Enum.GetValues<ProductClass>().Where(c => c != ProductClass.Scrap))
                    {
                        var clase = c;
                        <tr>
                            <td class="small"><i class="bi @InventoryState.ClassIcon(clase) me-1"></i> @InventoryState.ClassLabel(clase)</td>
                            <td>
                                <select class="form-select form-select-sm" style="width:320px;" @onchange="(e) => SetRutaCategoria(clase, e.Value?.ToString())">
                                    <option value="">— sin ruta —</option>
                                    @foreach (var r in Procurement.Rutas)
                                    {
                                        <option value="@r.Codigo" selected="@(RutaCategoria(clase) == r.Codigo)">@r.Nombre</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string? RutaProducto(string clave) =>
        Procurement.RutaPorProducto.TryGetValue(clave, out var r) ? r : null;

    private string? RutaCategoria(ProductClass c) =>
        Procurement.RutaPorCategoria.TryGetValue(c, out var r) ? r : null;

    private void SetRutaProducto(string clave, string? codigo)
    {
        if (string.IsNullOrEmpty(codigo)) Procurement.RutaPorProducto.Remove(clave);
        else Procurement.RutaPorProducto[clave] = codigo;
        StateHasChanged();
    }

    private void SetRutaCategoria(ProductClass c, string? codigo)
    {
        if (string.IsNullOrEmpty(codigo)) Procurement.RutaPorCategoria.Remove(c);
        else Procurement.RutaPorCategoria[c] = codigo;
        StateHasChanged();
    }

    private static string BadgeAccion(ProcurementAction a) => a switch
    {
        ProcurementAction.EntregarDeStock => "bg-primary-subtle text-primary-emphasis",
        ProcurementAction.Fabricar => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-info-subtle text-info-emphasis"
    };

    protected override void OnInitialized() => Procurement.OnChange += StateHasChanged;

    public void Dispose() => Procurement.OnChange -= StateHasChanged;
}
