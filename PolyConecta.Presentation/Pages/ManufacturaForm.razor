@using PolyConecta.Presentation.Components.Forms
@using PolyConecta.Presentation.Components.Chatter

<div class="d-flex flex-column w-100 p-3">
    <!-- Top Action Bar above sheet (Action buttons left, Smart Buttons right) -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary fw-bold px-3">Subir Pdf</button>
            <button class="btn btn-sm btn-outline-secondary fw-bold px-3">Validar</button>
        </div>

        <!-- Smart Buttons Box (Right side above sheet) -->
        <div class="d-flex flex-column align-items-end">
            <div class="border rounded bg-white p-1 d-flex gap-2">
                <button class="btn btn-sm btn-light border-0 fw-semibold text-dark p-1 d-flex flex-column align-items-center" style="font-size:0.7rem; line-height:1.1;" @onclick='() => OnSmartNavigate("pedido-form")'>
                    <span>Pedido de venta</span>
                    <span class="fw-bold">1</span>
                </button>
                <button class="btn btn-sm btn-light border-0 fw-semibold text-dark p-1 d-flex flex-column align-items-center" style="font-size:0.7rem; line-height:1.1;" @onclick='() => OnSmartNavigate("manufactura-list")'>
                    <span>Órdenes de Fabricación</span>
                    <span class="fw-bold">3</span>
                </button>
            </div>
            <span class="text-muted fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">SMART BUTTONS</span>
        </div>
    </div>

    <div class="d-flex gap-3 align-items-start w-100">
        <!-- Form Sheet Card -->
        <div class="flex-grow-1 bg-white border rounded p-4 shadow-sm" style="min-width: 0;">
            <!-- Top Row inside sheet: Folio on left, Pipeline Etapas on top right -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="small text-muted fw-bold d-block">Manufactura</span>
                    <h2 class="fw-bold font-monospace text-primary m-0">IV214-26</h2>
                </div>

                <!-- Pipeline Etapas (Inside sheet, top right) -->
                <div class="d-flex align-items-center gap-2 small font-semibold text-muted">
                    <span>Borrador</span>
                    <span>/</span>
                    <span>Autorizado</span>
                    <span>/</span>
                    <span class="text-primary fw-bold">En progreso</span>
                    <span>/</span>
                    <span>Hecho</span>
                </div>
            </div>

            <!-- Customer & Dates Info Grid -->
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <div class="mb-1">
                        <span class="small text-muted me-2">Cliente:</span>
                        <span class="fw-bold fs-6 text-dark">Vidrios de Mexico SA de CV</span>
                    </div>
                    <div>
                        <span class="small text-muted d-block">Ubicacion:</span>
                        <span class="small font-semibold text-dark">Planta Gracia, Carr. Mty Garcia Km s/n, Garcia N.L. C.P. 66000</span>
                    </div>
                </div>

                <div class="col-md-5 text-md-end">
                    <div class="mb-1">
                        <span class="small text-muted">Fecha: </span>
                        <span class="fw-semibold text-dark">23 abril 2026</span>
                    </div>
                    <div>
                        <span class="small text-muted">Fecha est. Entrega: </span>
                        <span class="fw-semibold text-dark">05 mayo 2026</span>
                    </div>
                </div>
            </div>

            <!-- Notebook Tabs -->
            <ul class="nav nav-tabs border-bottom mb-2">
                <li class="nav-item">
                    <button class="nav-link active fw-bold text-primary border-0 border-bottom border-primary border-2">Detalle</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link text-muted fw-semibold border-0">Adicionales</button>
                </li>
            </ul>

            <table class="table table-sm align-middle small font-monospace mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Codigo</th>
                        <th>No. Parte.</th>
                        <th>Descripcion</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-primary">51380V205</td>
                        <td>4010004547</td>
                        <td>Rollo tubular 20.5 x370 BD TPT...</td>
                        <td class="text-end fw-semibold">500</td>
                        <td class="text-end">51</td>
                        <td class="text-end fw-bold">25000</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Right Side Chatter Drawer Card -->
        <OdooChatterDrawer Messages="@chatterEntries" />
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private List<OdooChatterDrawer.ChatterEntry> chatterEntries = new()
    {
        new OdooChatterDrawer.ChatterEntry { Author = "Sistema Odoo 19", Timestamp = "12:35 pm", Text = "Orden de manufactura IV214-26 en estado 'En progreso'" }
    };

    private void OnSmartNavigate(string route) => OnNavigate.InvokeAsync(route);
}
