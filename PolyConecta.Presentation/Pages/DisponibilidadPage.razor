@page "/disponibilidad"
@inject InventoryState Inv
@inject NavigationManager NavManager
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <OdooBreadcrumb Items="@(new List<OdooBreadcrumb.Crumb> { new("Disponibilidad", "/disponibilidad") })" />
    </div>
    <div class="d-flex align-items-center gap-2">
        <OdooSearchPanel TItem="AvailabilityRow"
                         View="@SearchViews.Disponibilidad"
                         @bind-Texto="Texto"
                         @bind-FiltrosActivos="filtros" />
    </div>
</div>

<div class="p-4">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-sm @(Clase == null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => Clase = null">
            Todas
        </button>
        @foreach (var c in Clases)
        {
            var actual = c;
            <button class="btn btn-sm @(Clase == actual ? "btn-primary" : "btn-outline-secondary")" @onclick="() => Clase = actual">
                <i class="bi @InventoryState.ClassIcon(actual) me-1"></i> @InventoryState.ClassLabel(actual)
            </button>
        }
    </div>

    <div class="o_form_sheet">
        <div class="o_sheet_body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Visor de disponibilidad</h5>
                    <p class="text-muted small mb-0">
                        Existencias por clasificación de producto. <span class="fw-semibold">Disponible</span> = físico − reservado − WIP.
                        Cuarentena y scrap quedan fuera del material vendible.
                    </p>
                </div>
                <div class="text-end small text-muted">
                    <div>Fecha de referencia</div>
                    <input type="date" class="form-control form-control-sm" style="width:150px;" @bind="FechaRef" />
                </div>
            </div>

            @if (Filas.Count == 0)
            {
                <p class="text-muted fst-italic mb-0">Sin existencias para este filtro.</p>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead class="text-muted small">
                        <tr>
                            <th style="width:34px;"></th>
                            <th style="width:15%;">Clave</th>
                            <th>Producto</th>
                            <th style="width:150px;">Ubicación</th>
                            <th class="text-center" style="width:95px;">Físico</th>
                            <th class="text-center" style="width:95px;" title="Comprometido por un pedido; sigue en el almacén">Reservado</th>
                            <th class="text-center" style="width:95px;" title="Recolectado a producción: sigue siendo inventario, ya no está disponible">En WIP</th>
                            <th class="text-center" style="width:100px;">Disponible</th>
                            <th class="text-center" style="width:110px;" title="Producción u arribo esperado">Entrante</th>
                            <th class="text-center" style="width:70px;">Unidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Filas)
                        {
                            var key = fila.Producto.Clave + "|" + fila.Ubicacion;
                            var abierto = Expandido == key;
                            var vendible = InventoryState.EsVendible(fila.Ubicacion);
                            <tr style="cursor:pointer;" class="@(abierto ? "table-active" : "")" @onclick="() => Expandido = abierto ? null : key">
                                <td class="text-center text-muted"><i class="bi @(abierto ? "bi-chevron-down" : "bi-chevron-right")"></i></td>
                                <td class="small fw-semibold text-primary">@fila.Producto.Clave</td>
                                <td class="small">@fila.Producto.Nombre</td>
                                <td class="small text-muted">@fila.Ubicacion</td>
                                <td class="text-center">@fila.Fisico.ToString("N1")</td>
                                <td class="text-center @(fila.Reservado > 0 ? "text-warning-emphasis fw-semibold" : "text-muted")">@fila.Reservado.ToString("N1")</td>
                                <td class="text-center @(fila.EnWip > 0 ? "text-info-emphasis fw-semibold" : "text-muted")">@fila.EnWip.ToString("N1")</td>
                                <td class="text-center fw-semibold @(!vendible ? "text-muted" : fila.Disponible > 0 ? "text-primary" : "text-danger")">
                                    @(vendible ? fila.Disponible.ToString("N1") : "—")
                                </td>
                                <td class="text-center small">
                                    @if (fila.Entrante > 0)
                                    {
                                        <span class="text-success-emphasis fw-semibold">+@fila.Entrante.ToString("N1")</span>
                                        <span class="d-block text-muted" style="font-size:.72rem;">@fila.PrimerArribo?.ToString("dd/MM/yy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center small text-muted">@fila.Producto.Unidad</td>
                            </tr>
                            @if (abierto)
                            {
                                <tr>
                                    <td></td>
                                    <td colspan="9" class="bg-light-subtle">
                                        <div class="small fw-semibold text-uppercase text-muted mb-2" style="font-size:.7rem;">Detalle por lote</div>
                                        <table class="table table-sm mb-2">
                                            <thead class="text-muted" style="font-size:.75rem;">
                                                <tr>
                                                    <th>Lote</th>
                                                    <th class="text-center" style="width:110px;">Cantidad</th>
                                                    <th class="text-center" style="width:120px;">Estado</th>
                                                    <th style="width:180px;">Comprometido por</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var lote in Inv.LotesDe(fila.Producto.Clave, fila.Ubicacion))
                                                {
                                                    <tr>
                                                        <td class="small font-monospace">@lote.Lote</td>
                                                        <td class="text-center small">@lote.Cantidad.ToString("N1") @fila.Producto.Unidad</td>
                                                        <td class="text-center"><span class="badge @BadgeDe(lote.Estado)">@lote.Estado</span></td>
                                                        <td class="small text-muted">@(lote.ComprometidoPor ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @{
                                            var sustituciones = Inv.Sustituciones.Where(s => s.ClaveSustituta == fila.Producto.Clave).ToList();
                                        }
                                        @if (sustituciones.Count > 0)
                                        {
                                            <div class="alert alert-light border small mb-0 py-2">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Este producto se ha usado antes como sustituto
                                                @foreach (var g in sustituciones.GroupBy(s => s.ClaveVendida))
                                                {
                                                    <span class="fw-semibold">de @g.Key (@g.Count() @(g.Count() == 1 ? "vez" : "veces"))</span>
                                                }
                                                — referencia histórica, no una recomendación del sistema.
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private static readonly ProductClass[] Clases = Enum.GetValues<ProductClass>();

    private ProductClass? Clase;
    private string Texto = "";
    private List<string> filtros = new();
    private string? Expandido;
    private DateTime FechaRef = new DateTime(2026, 9, 30);

    // Las clasificaciones siguen siendo la navegación primaria; la búsqueda y los filtros
    // los resuelve la vista del modelo.
    private List<AvailabilityRow> Filas => SearchViews.Disponibilidad
        .Aplicar(Inv.Filas(Clase), Texto, filtros)
        .OrderBy(f => f.Producto.Clasificacion)
        .ThenBy(f => f.Producto.Clave)
        .ThenBy(f => f.Ubicacion)
        .ToList();

    private static string BadgeDe(LotStatus s) => s switch
    {
        LotStatus.Libre => "bg-primary-subtle text-primary-emphasis",
        LotStatus.Reservado => "bg-warning-subtle text-warning-emphasis",
        LotStatus.EnWip => "bg-info-subtle text-info-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    protected override void OnInitialized() => Inv.OnChange += StateHasChanged;

    public void Dispose() => Inv.OnChange -= StateHasChanged;
}
