@page "/pedidos/{Folio}"
@inject OperationalFlowState Flow
@inject NavigationManager NavManager
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary btn-sm fw-bold px-3" disabled="disabled" title="Alta manual deshabilitada en esta demo: los pedidos nacen de la sincronización con CONTPAQi">
            <i class="bi bi-plus-lg me-1"></i> Nuevo
        </button>
        <OdooBreadcrumb Items="@(new List<OdooBreadcrumb.Crumb> { new("Pedidos", "/pedidos"), new(Folio) })" />
    </div>
    <div class="o_button_box">
        <OdooSmartButtons Buttons="@SmartButtons" OnSmartNavigate="@((route) => NavManager.NavigateTo(route))" />
    </div>
</div>

<div class="p-4">
    <!-- Fuera de .o_form_sheet: los botones de acción flotan sobre el fondo de la página,
         no dentro del cuadro blanco del documento (ver .o_statusbar en app.css). -->
    <div class="o_statusbar">
        <div class="d-flex align-items-center gap-2">
            @switch (Flow.CurrentOrderStage)
            {
                case "Borrador":
                    <button class="btn btn-primary btn-sm fw-bold px-3" @onclick='() => Flow.SetOrderStage("Confirmado")'>
                        <i class="bi bi-check-circle me-1"></i> Confirmar
                    </button>
                    break;
                case "Confirmado":
                    <button class="btn btn-primary btn-sm fw-bold px-3" @onclick="() => Flow.Autorizar()">
                        <i class="bi bi-check-circle me-1"></i> Autorizar
                        <span class="badge bg-light text-dark ms-1">@Flow.FirmasRecogidas/2</span>
                    </button>
                    break;
            }
            @if (Flow.CurrentOrderStage != "Hecho")
            {
                <button class="btn btn-outline-secondary btn-sm px-3" @onclick='() => NavManager.NavigateTo("/pedidos")'>Cancelar</button>
            }
        </div>
    </div>

    <div class="d-flex gap-3 align-items-start">
        <div class="o_form_sheet flex-grow-1">
            <div class="o_sheet_body">
                <OdooStatusPipeline Stages="@Stages" CurrentStage="@Flow.CurrentOrderStage" />
                <PocSalesOrderForm />
            </div>
        </div>
        <OdooChatterDrawer Messages="@chatterEntries" />
    </div>
</div>

@code {
    [Parameter] public string Folio { get; set; } = OperationalFlowState.PedidoFolio;

    private static readonly List<string> Stages = new() { "Borrador", "Confirmado", "Autorizado", "En progreso", "Hecho" };

    private List<OdooSmartButtons.SmartButtonModel> SmartButtons => new()
    {
        new() { Label = "Entrega", CountBadge = 1, IconClass = "bi bi-truck", TargetRoute = $"/entregas/{Flow.Entrega.Folio}" },
        new() { Label = "Fabricación", CountBadge = Flow.OrdenesDePedido(Folio).Count, IconClass = "bi bi-diagram-3", TargetRoute = $"/fabricacion?pedido={Folio}" }
    };

    private List<OdooChatterDrawer.ChatterEntry> chatterEntries
    {
        get
        {
            var entradas = new List<OdooChatterDrawer.ChatterEntry>
            {
                new() { Timestamp = "17 Sep 26", Text = "Creación del pedido por Alejandro" }
            };
            foreach (var (rol, quien) in Flow.Firmas)
                entradas.Add(new() { Timestamp = "hoy", Text = $"Autorización de {rol} firmada por {quien}" });
            return entradas;
        }
    }

    protected override void OnInitialized() => Flow.OnChange += StateHasChanged;

    public void Dispose() => Flow.OnChange -= StateHasChanged;
}
