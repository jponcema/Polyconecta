@page "/"

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Dashboard de producción</h3>
            <p class="text-muted small">Vista operacional global PolyConecta | C# Blazor Component</p>
        </div>
        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
            <i class="bi bi-activity me-1"></i> CONTPAQi Sync Status: OK
        </span>
    </div>

    <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center justify-content-between mb-4">
        <div>
            <h6 class="fw-bold mb-1"><i class="bi bi-play-circle-fill me-1"></i> Demostración interactiva end-to-end</h6>
            <p class="mb-0 small">Recorre las 7 fases operativas validadas: pedido, MRP, báscula/calidad, cierre, logística y conversión.</p>
        </div>
        <a href="/pedidos" class="btn btn-primary fw-bold px-4">Iniciar demo <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small font-semibold">PEDIDOS CONTPAQi ACTIVOS</div>
                <div class="fs-2 fw-bold text-primary my-1">18</div>
                <div class="small text-success"><i class="bi bi-arrow-up-short"></i> 3 nuevos hoy</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small font-semibold">ÓRDENES EN FABRICACIÓN</div>
                <div class="fs-2 fw-bold text-warning my-1">12</div>
                <div class="small text-muted">6 Extrusión / 4 Imprenta</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small font-semibold">TONELADAS PRODUCIDAS (MES)</div>
                <div class="fs-2 fw-bold text-success my-1">142.8 Tn</div>
                <div class="small text-success"><i class="bi bi-check-circle me-1"></i> 98.4% Quality Pass</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-muted small font-semibold">LOTE CUARENTENA</div>
                <div class="fs-2 fw-bold text-danger my-1">0.4 Tn</div>
                <div class="small text-danger">1 lote retenido por MFI</div>
            </div>
        </div>
    </div>
</div>
