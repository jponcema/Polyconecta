@page "/fabricacion"
@inject OperationalFlowState Flow
@inject UiViewState ViewState
@inject NavigationManager NavManager
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary btn-sm fw-bold px-3" disabled="disabled" title="Alta manual deshabilitada en esta demo: las Órdenes de Fabricación nacen del Pedido">
            <i class="bi bi-plus-lg me-1"></i> Nuevo
        </button>
        <OdooBreadcrumb Items="@Breadcrumb" />
    </div>
    <OdooSearchPanel TItem="ManufacturingOrder"
                     View="@SearchViews.Fabricacion"
                     FacetasContexto="@Facetas"
                     @bind-Texto="searchText"
                     @bind-FiltrosActivos="filtros" />
    <div class="d-flex align-items-center gap-2">
        <OdooViewSwitcher />
    </div>
</div>

<div class="p-4">
    @if (ViewState.ViewMode == "Kanban")
    {
        <div class="o_kanban_board">
            @foreach (var stage in Stages)
            {
                <div class="o_kanban_column">
                    <div class="o_kanban_column_title">
                        <span>@stage</span>
                        <span class="badge bg-secondary">@FilteredOrders.Count(o => o.State == stage)</span>
                    </div>
                    @foreach (var of in FilteredOrders.Where(o => o.State == stage))
                    {
                        <div class="kanban-card" @onclick="() => Abrir(of.Folio)">
                            <div class="fw-bold text-dark small">@of.Folio</div>
                            <div class="text-muted small">@of.ProcessLabel</div>
                            <div class="badge badge-brand mt-2">@of.State</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th style="width:36px;"><input type="checkbox" class="form-check-input" @onchange="ToggleAll" /></th>
                    <th>Folio</th>
                    <th>Producto</th>
                    <th>Proceso</th>
                    <th class="text-end">Cantidad</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var nodo in ArbolPlano)
                {
                    <tr style="cursor:pointer;" class="@(selected.Contains(nodo.Of.Folio) ? "table-active" : "")" @onclick="() => Abrir(nodo.Of.Folio)">
                        <td @onclick:stopPropagation="true"><input type="checkbox" class="form-check-input" checked="@selected.Contains(nodo.Of.Folio)" @onchange="() => ToggleOne(nodo.Of.Folio)" /></td>
                        <td class="fw-semibold text-primary" style="padding-left:@(12 + nodo.Nivel * 26)px;">
                            @if (nodo.Nivel > 0)
                            {
                                <i class="bi bi-arrow-return-right text-muted me-1" style="opacity:.55;"></i>
                            }
                            @nodo.Of.Folio
                            @if (nodo.Nivel == 0 && nodo.Hijos.Count > 0)
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2" style="font-size:.65rem;">maestra</span>
                            }
                        </td>
                        <td>@nodo.Of.Producto</td>
                        <td>@nodo.Of.ProcessLabel</td>
                        <td class="text-end">@nodo.Of.Cantidad.ToString("N1") @nodo.Of.Unidad</td>
                        <td><span class="badge badge-brand">@nodo.Of.State</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <OdooPager Count="@FilteredOrders.Count" />
</div>

@code {
    private static readonly List<string> Stages = new() { "Borrador", "Planeado", "En progreso", "Hecho" };

    private string searchText = "";
    private readonly HashSet<string> selected = new();

    /// <summary>Filtro por pedido: el smart button del Pedido enlaza aquí con su folio.</summary>
    [SupplyParameterFromQuery(Name = "pedido")] public string? Pedido { get; set; }

    private List<OdooBreadcrumb.Crumb> Breadcrumb => string.IsNullOrEmpty(Pedido)
        ? new() { new("Órdenes de Fabricación") }
        : new()
        {
            new("Pedidos", "/pedidos"),
            new(Pedido, $"/pedidos/{Pedido}"),
            new("Órdenes de Fabricación")
        };

    /// <summary>
    /// El contexto de navegación se expresa como faceta en la barra de búsqueda, igual que
    /// cualquier filtro que el usuario aplique: se ve y se quita del mismo modo.
    /// </summary>
    private List<OdooSearchPanel<ManufacturingOrder>.Facet> Facetas => string.IsNullOrEmpty(Pedido)
        ? new()
        : new() { new("Pedido", Pedido!, EventCallback.Factory.Create(this, QuitarFiltroPedido)) };

    private List<string> filtros = new();

    private void QuitarFiltroPedido() => NavManager.NavigateTo("/fabricacion");

    // La búsqueda la resuelve la vista del modelo; la lista solo aporta el filtro de contexto.
    private List<ManufacturingOrder> FilteredOrders => SearchViews.Fabricacion.Aplicar(
        Flow.ManufacturingOrders.Where(o => string.IsNullOrEmpty(Pedido) || o.PedidoFolio == Pedido),
        searchText, filtros);

    private record Nodo(ManufacturingOrder Of, int Nivel, List<Nodo> Hijos);

    /// <summary>
    /// La estructura de datos no cambia — sigue siendo la misma lista con OriginFolio.
    /// Lo único que cambia es cómo se muestra: anidada por jerarquía.
    /// </summary>
    private List<Nodo> Arbol
    {
        get
        {
            var visibles = FilteredOrders;
            var folios = visibles.Select(o => o.Folio).ToHashSet();

            List<Nodo> Hijos(string folio, int nivel) => visibles
                .Where(o => o.OriginFolio == folio)
                .OrderBy(o => o.Folio)
                .Select(o => new Nodo(o, nivel, Hijos(o.Folio, nivel + 1)))
                .ToList();

            // Raíz: sin origen, o cuyo origen quedó fuera del filtro actual.
            return visibles
                .Where(o => o.OriginFolio == null || !folios.Contains(o.OriginFolio))
                .OrderBy(o => o.Folio)
                .Select(o => new Nodo(o, 0, Hijos(o.Folio, 1)))
                .ToList();
        }
    }

    /// <summary>Recorrido en profundidad: cada fila conoce su nivel de anidamiento.</summary>
    private List<Nodo> ArbolPlano
    {
        get
        {
            var plano = new List<Nodo>();
            void Recorrer(IEnumerable<Nodo> nodos)
            {
                foreach (var n in nodos)
                {
                    plano.Add(n);
                    Recorrer(n.Hijos);
                }
            }
            Recorrer(Arbol);
            return plano;
        }
    }

    /// <summary>
    /// Abre la OF arrastrando el contexto actual: al volver, el breadcrumb devuelve a esta
    /// misma lista filtrada y no a la lista completa.
    /// </summary>
    private void Abrir(string folio) => NavManager.NavigateTo(
        string.IsNullOrEmpty(Pedido) ? $"/fabricacion/{folio}" : $"/fabricacion/{folio}?pedido={Pedido}");

    private void ToggleOne(string folio)
    {
        if (!selected.Remove(folio)) selected.Add(folio);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        selected.Clear();
        if (check) foreach (var of in FilteredOrders) selected.Add(of.Folio);
    }

    protected override void OnInitialized()
    {
        Flow.OnChange += StateHasChanged;
        ViewState.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Flow.OnChange -= StateHasChanged;
        ViewState.OnStateChanged -= StateHasChanged;
    }
}
