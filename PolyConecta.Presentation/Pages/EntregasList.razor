@page "/entregas"
@inject OperationalFlowState Flow
@inject NavigationManager NavManager
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary btn-sm fw-bold px-3" disabled="disabled" title="Alta manual fuera de alcance de esta demo">
            <i class="bi bi-plus-lg me-1"></i> Nuevo
        </button>
        <OdooBreadcrumb Items="@(new List<OdooBreadcrumb.Crumb> { new("Entregas") })" />
    </div>
    <OdooSearchBox @bind-Value="searchText" />
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group btn-group-sm o_view_switcher">
            <button class="btn-view active" disabled><i class="bi bi-list-ul"></i></button>
        </div>
    </div>
</div>

<div class="p-4">
    <table class="table table-hover align-middle bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th style="width:36px;"><input type="checkbox" class="form-check-input" @onchange="ToggleAll" /></th>
                <th>Folio</th><th>Operación</th><th>Destino</th><th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (ShowRow)
            {
                <tr style="cursor:pointer;" class="@(selected ? "table-active" : "")" @onclick='() => NavManager.NavigateTo($"/entregas/{Flow.Entrega.Folio}")'>
                    <td @onclick:stopPropagation="true"><input type="checkbox" class="form-check-input" checked="@selected" @onchange="() => selected = !selected" /></td>
                    <td class="fw-semibold text-primary">#@Flow.Entrega.Folio</td>
                    <td>@Flow.Entrega.Operacion</td>
                    <td>@Flow.Entrega.Destino</td>
                    <td><span class="badge badge-brand">@Flow.Entrega.State</span></td>
                </tr>
            }
        </tbody>
    </table>
    <OdooPager Count="@(ShowRow ? 1 : 0)" />
</div>

@code {
    private string searchText = "";
    private bool selected = false;
    private bool ShowRow => string.IsNullOrWhiteSpace(searchText)
        || Flow.Entrega.Folio.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        || Flow.Entrega.Operacion.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        || Flow.Entrega.Destino.Contains(searchText, StringComparison.OrdinalIgnoreCase);

    private void ToggleAll(ChangeEventArgs e) => selected = e.Value is bool b && b;

    protected override void OnInitialized() => Flow.OnChange += StateHasChanged;
    public void Dispose() => Flow.OnChange -= StateHasChanged;
}
