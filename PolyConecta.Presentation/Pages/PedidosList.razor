@page "/pedidos"
@inject OperationalFlowState Flow
@inject UiViewState ViewState
@implements IDisposable

<div class="o_control_panel">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-primary btn-sm fw-bold px-3" disabled="disabled" title="Alta manual deshabilitada en esta demo: los pedidos nacen de la sincronización con CONTPAQi">
            <i class="bi bi-plus-lg me-1"></i> Nuevo
        </button>
        <OdooBreadcrumb Items="@(new List<OdooBreadcrumb.Crumb> { new("Pedidos") })" />
    </div>
    <OdooSearchPanel TItem="SearchViews.SalesOrderRow"
                     View="@SearchViews.Pedidos"
                     @bind-Texto="searchText"
                     @bind-FiltrosActivos="filtros" />
    <div class="d-flex align-items-center gap-2">
        <OdooViewSwitcher />
    </div>
</div>

<div class="p-4">
    @if (ViewState.ViewMode == "Kanban")
    {
        <div class="o_kanban_board">
            @foreach (var stage in Stages)
            {
                <div class="o_kanban_column">
                    <div class="o_kanban_column_title">
                        <span>@stage</span>
                        <span class="badge bg-secondary">@(ShowRow && Flow.CurrentOrderStage == stage ? 1 : 0)</span>
                    </div>
                    @if (ShowRow && Flow.CurrentOrderStage == stage)
                    {
                        <div class="kanban-card" @onclick="GoToForm">
                            <div class="fw-bold text-dark small">@SampleFolio</div>
                            <div class="text-muted small">@SampleCustomer</div>
                            <div class="text-muted small mt-1"><i class="bi bi-box-seam me-1"></i>@SampleSku</div>
                            <div class="badge badge-brand mt-2">@Flow.CurrentOrderStage</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th style="width:36px;"><input type="checkbox" class="form-check-input" @onchange="ToggleAll" /></th>
                    <th>Folio</th>
                    <th>Cliente</th>
                    <th>SKU Producto Terminado</th>
                    <th class="text-end">Cantidad</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (ShowRow)
                {
                    <tr style="cursor:pointer;" class="@(selected ? "table-active" : "")" @onclick="GoToForm">
                        <td @onclick:stopPropagation="true"><input type="checkbox" class="form-check-input" checked="@selected" @onchange="() => selected = !selected" /></td>
                        <td class="fw-semibold text-primary">@SampleFolio</td>
                        <td>@SampleCustomer</td>
                        <td>@SampleSku</td>
                        <td class="text-end">5,500.0 PZA</td>
                        <td><span class="badge badge-brand">@Flow.CurrentOrderStage</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <OdooPager Count="@(ShowRow ? 1 : 0)" />
</div>

@code {
    private const string SampleFolio = OperationalFlowState.PedidoFolio;
    private const string SampleCustomer = "EMPRESA MEXICANA DE MANUFACTURA";
    private const string SampleSku = "PT1113 C567";

    private static readonly List<string> Stages = new() { "Borrador", "Confirmado", "Autorizado", "En progreso", "Hecho" };

    private string searchText = "";
    private bool selected = false;
    private List<string> filtros = new();

    private bool ShowRow => SearchViews.Pedidos.Aplicar(
        new[] { new SearchViews.SalesOrderRow(SampleFolio, SampleCustomer, SampleSku, Flow.CurrentOrderStage) },
        searchText, filtros).Count > 0;

    private void ToggleAll(ChangeEventArgs e) => selected = e.Value is bool b && b;

    [Inject] private NavigationManager NavManager { get; set; } = default!;

    protected override void OnInitialized()
    {
        Flow.OnChange += StateHasChanged;
        ViewState.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Flow.OnChange -= StateHasChanged;
        ViewState.OnStateChanged -= StateHasChanged;
    }

    private void GoToForm() => NavManager.NavigateTo($"/pedidos/{SampleFolio}");
}
