@page "/manufactura"
@page "/piso/bascula"
@page "/manufactura/cierre"
@page "/logistica"
@page "/conversion"
@implements IDisposable
@inject NavigationManager NavManager
@inject OperationalFlowState Flow

<div class="container-fluid p-0">
    <!-- Stepper de Navegación por las 7 Fases Operativas -->
    <div class="bg-white border-bottom shadow-xs px-4 py-2 overflow-auto">
        <div class="d-flex align-items-center gap-2 text-nowrap">
            <span class="badge bg-success-subtle text-success border border-success me-2">
                <i class="bi bi-check-circle me-1"></i> 17 Reglas Operativas Validadas
            </span>
            @for (int i = 1; i <= 7; i++)
            {
                var stepIndex = i;
                var isActive = ActiveStep == stepIndex;
                var isDone = Flow.StepCompleted[stepIndex];
                <button class="btn btn-sm d-flex align-items-center gap-2 px-3 rounded-pill @(isActive ? "btn-primary fw-bold" : isDone ? "btn-outline-success" : "btn-outline-secondary")"
                        @onclick="() => GoToStep(stepIndex)">
                    <span class="badge rounded-circle @(isActive ? "bg-white text-primary" : isDone ? "bg-success text-white" : "bg-secondary text-white")">
                        @stepIndex
                    </span>
                    <span>@GetStepTitle(stepIndex)</span>
                    @if (isDone)
                    {
                        <i class="bi bi-check-lg text-success ms-1"></i>
                    }
                </button>

                @if (i < 7)
                {
                    <i class="bi bi-chevron-right text-muted opacity-50"></i>
                }
            }
        </div>
    </div>

    <!-- Main Container del Contenido Activo -->
    <div class="p-4 container-xl">
        <!-- Banner Informativo de la Fase Activa -->
        <div class="alert alert-info border-0 shadow-xs mb-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-info-circle-fill fs-3 text-info"></i>
                <div>
                    <h6 class="fw-bold mb-1">Fase @ActiveStep: @GetStepTitle(ActiveStep)</h6>
                    <p class="mb-0 small text-slate-700">@GetStepDescription(ActiveStep)</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm px-3" @onclick="() => Flow.ResetAll()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reiniciar demo
                </button>
                <button class="btn btn-primary btn-sm px-4 fw-bold" @onclick="NextStep" disabled="@(ActiveStep == 7)">
                    Siguiente Fase <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Renderizado Componente de la Fase (una ruta real por fase) -->
        @switch (ActiveStep)
        {
            case 3:
                <PocMrpHierarchy ExtrusionState="@Flow.ExtrusionState"
                                 AssignedMachine="@Flow.AssignedMachine"
                                 BomLoaded="@Flow.BomLoaded"
                                 OnBomParsed="() => Flow.ParseBom()"
                                 OnExtruderAssigned="() => Flow.AssignExtruder()" />
                break;

            case 4:
                <PocHandheldScaleTerminal OnRollWeighed="() => Flow.MarkStep4Complete()" />
                break;

            case 5:
                <PocMassBalanceConsole Closed="@Flow.ClosureExecuted"
                                       OnClosureCompleted="() => Flow.CompleteClosure()" />
                break;

            case 6:
                <PocLogisticsRouting TransferStep="@Flow.TransferStep"
                                     TransferStepChanged="Flow.SetTransferStep" />
                break;

            case 7:
                <PocBaggingConversion BaggingDone="@Flow.BaggingCompleted"
                                      OnBaggingCompleted="() => Flow.CompleteBagging()" />
                break;
        }
    </div>
</div>

@code {
    private static readonly Dictionary<int, string> StepPaths = new()
    {
        { 1, "/pedidos" }, { 2, "/pedidos" }, { 3, "/manufactura" }, { 4, "/piso/bascula" },
        { 5, "/manufactura/cierre" }, { 6, "/logistica" }, { 7, "/conversion" }
    };

    private int ActiveStep
    {
        get
        {
            var path = new Uri(NavManager.Uri).AbsolutePath;
            return path switch
            {
                "/manufactura" => 3,
                "/piso/bascula" => 4,
                "/manufactura/cierre" => 5,
                "/logistica" => 6,
                "/conversion" => 7,
                _ => 3
            };
        }
    }

    protected override void OnInitialized()
    {
        Flow.OnChange += StateHasChanged;
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Flow.OnChange -= StateHasChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void GoToStep(int step) => NavManager.NavigateTo(StepPaths[step]);

    private void NextStep()
    {
        var step = ActiveStep;
        if (step == 7) return;

        Flow.StepCompleted[step] = true;
        NavManager.NavigateTo(StepPaths[step + 1]);
    }

    private string GetStepTitle(int step) => step switch
    {
        1 => "Captura Pedido ERP",
        2 => "Sincronización & Aprobaciones",
        3 => "Jerarquía MRP & Receta 3 Capas",
        4 => "Pesaje Handheld & Calidad",
        5 => "Balance de Masa & Cierre ERP",
        6 => "Logística & Traspaso 2 Pasos",
        7 => "Conversión Bolseo Santa Cruz",
        _ => ""
    };

    private string GetStepDescription(int step) => step switch
    {
        1 => "Captura del Pedido en CONTPAQi con Campos de Usuario de Extrusión y Conversión (0 Archivos Excel OT).",
        2 => "Sincronización en PolyConecta y firmas digitales de Ventas y Crédito/Cobranza en el pipeline Odoo 19.",
        3 => "Jerarquía OM Maestra -> OFs -> WO en 'Por programar', ingesta de la receta de 3 capas y asignación a máquina.",
        4 => "Pesaje en báscula móvil, precarga de slots, inspección de calidad y regla de reciclaje de lote en cuarentena .S.",
        5 => "Cierre técnico con balance de masa (Masa Total Extruida) y único descuento consolidado de insumos en CONTPAQi ERP.",
        6 => "Navegación Smart Buttons (Entregas Directas vs Traslados Interplanta en 2 Pasos PIM -> TRANSIT -> Santa Cruz).",
        7 => "Ejecución de OF-BOL en Santa Cruz aplicando las 4 Reglas Universales, Registro Dual (Millares/Kg) y marcación 'Hecho'.",
        _ => ""
    };
}
