{
  "openapi": "3.0.3",
  "info": {
    "title": "PolyConecta Chatter & Audit Log API",
    "version": "1.0.0",
    "description": "API endpoints for reading Chatter history and posting user comments / audit logs"
  },
  "paths": {
    "/api/v1/chatter/{documentId}": {
      "get": {
        "summary": "Get full Chatter message history and audit log for a document",
        "parameters": [
          { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of chatter entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "./ui-component-contracts.json#/definitions/ChatterEntry" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post a new user comment to the Chatter drawer",
        "parameters": [
          { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["authorName", "bodyText"],
                "properties": {
                  "authorName": { "type": "string" },
                  "bodyText": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Comment posted and broadcasted successfully" }
        }
      }
    }
  }
}
