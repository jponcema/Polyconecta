{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solution Architecture Layer Contract",
  "description": "Defines strict layer dependencies and boundaries for PolyConecta Clean Architecture",
  "type": "object",
  "properties": {
    "solutionName": { "type": "string", "const": "Polyconecta" },
    "targetFramework": { "type": "string", "const": "net8.0" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layerOrder": { "type": "integer" },
          "projectName": { "type": "string" },
          "architectureRole": { "type": "string" },
          "allowedDependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["layerOrder", "projectName", "architectureRole", "allowedDependencies"]
      }
    }
  },
  "required": ["solutionName", "targetFramework", "layers"]
}
