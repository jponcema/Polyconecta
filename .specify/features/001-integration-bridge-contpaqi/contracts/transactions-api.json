{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONTPAQi Integration Bridge Transactions API Contract",
  "version": "1.0.0",
  "description": "Standardized application-agnostic REST API schema for ERP transaction commands and DLQ management.",
  "endpoints": {
    "POST /api/v1/transactions": {
      "summary": "Submit a generic ERP write transaction command",
      "request": {
        "type": "object",
        "required": ["client_app_id", "command_type", "payload"],
        "properties": {
          "correlation_id": { "type": "string", "format": "uuid", "description": "Optional client-supplied tracing UUID" },
          "client_app_id": { "type": "string", "example": "polyconecta-shopfloor" },
          "idempotency_key": { "type": "string", "example": "REQ-20260911-001" },
          "callback_url": { "type": "string", "format": "uri", "example": "https://api.polyconecta.io/webhooks/erp" },
          "command_type": {
            "type": "string",
            "enum": ["DOCUMENT_CREATE", "MOVEMENT_ADD", "LOT_ASSOCIATION", "DOCUMENT_AFFECT"]
          },
          "payload": {
            "type": "object",
            "required": ["codigo_concepto", "codigo_cliente_proveedor", "fecha"],
            "properties": {
              "codigo_concepto": { "type": "string", "example": "3" },
              "codigo_cliente_proveedor": { "type": "string", "example": "CLI001" },
              "fecha": { "type": "string", "format": "date", "example": "2026-09-11" },
              "codigo_agente": { "type": "string", "example": "AGE01" },
              "referencia": { "type": "string", "example": "OP-88219" },
              "observaciones": { "type": "string", "example": "Consumo MP Apodaca" },
              "movimientos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["codigo_producto", "unidades", "codigo_almacen"],
                  "properties": {
                    "codigo_producto": { "type": "string", "example": "RES-HDPE-01" },
                    "unidades": { "type": "number", "example": 250.5 },
                    "precio": { "type": "number", "example": 45.0 },
                    "codigo_almacen": { "type": "string", "example": "ALM-MP" },
                    "lote": {
                      "type": "object",
                      "properties": {
                        "numero_lote": { "type": "string", "example": "LOT-2026-X9" },
                        "fecha_caducidad": { "type": "string", "format": "date", "example": "2027-09-11" },
                        "pedimento": { "type": "string", "example": "PED-44102" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "202": {
          "description": "Transaction accepted and queued in Outbox",
          "body": {
            "transaction_id": "c1f3a2b4-5678-4e9b-8123-abcdef123456",
            "correlation_id": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
            "status": "PENDING",
            "created_at": "2026-09-11T12:50:00Z"
          }
        },
        "400": {
          "description": "Invalid payload format or missing mandatory fields"
        }
      }
    },
    "GET /api/v1/transactions/{id}": {
      "summary": "Retrieve status and details of a submitted transaction",
      "responses": {
        "200": {
          "body": {
            "transaction_id": "c1f3a2b4-5678-4e9b-8123-abcdef123456",
            "correlation_id": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
            "status": "COMPLETED",
            "retry_count": 0,
            "contpaqi_doc_id": 48102,
            "contpaqi_folio": "F-00129",
            "updated_at": "2026-09-11T12:50:02Z"
          }
        }
      }
    },
    "GET /api/v1/dlq": {
      "summary": "List all transactions currently in Dead Letter Queue status",
      "responses": {
        "200": {
          "body": {
            "total_items": 1,
            "items": [
              {
                "transaction_id": "a9e8d7c6-5432-10fe-ba98-76543210fedc",
                "client_app_id": "polyconecta-shopfloor",
                "command_type": "DOCUMENT_CREATE",
                "retry_count": 5,
                "last_error_code": 2,
                "last_error_message": "El codigo de producto RES-INVALID no existe en admProductos",
                "created_at": "2026-09-11T12:00:00Z"
              }
            ]
          }
        }
      }
    },
    "POST /api/v1/dlq/{id}/retry": {
      "summary": "Re-queue a DLQ transaction for immediate execution attempt"
    },
    "POST /api/v1/dlq/{id}/edit-and-retry": {
      "summary": "Update the payload of a DLQ transaction and re-queue it for execution"
    },
    "DELETE /api/v1/dlq/{id}": {
      "summary": "Purge a transaction from the Dead Letter Queue"
    }
  }
}
